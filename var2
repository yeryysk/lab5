using System;
using System.Diagnostics;

namespace Rozumatic_ASD_Lab5_Variant2
{
    public class Node<T>
    {
        public T Data { get; set; }
        public Node<T>? Next { get; set; }

        public Node(T data)
        {
            Data = data;
            Next = null;
        }
    }

    public class SinglyLinkedList<T> where T : IEquatable<T>
    {
        private Node<T>? _head;
        private int _count;
        
        // ВАРІАНТ 2: Додаємо посилання на хвіст (tail)
        private Node<T>? _tail; 

        public int Count => _count;
        public bool IsEmpty => _count == 0;

        public void AddFirst(T data)
        {
            Node<T> newNode = new Node<T>(data);
            newNode.Next = _head;
            _head = newNode;

            if (_tail == null) _tail = newNode; // Якщо список був порожній
            _count++;
        }

        // ==========================================
        // ВАРІАНТ 2: Оптимізована вставка в кінець - O(1)
        // ==========================================
        public void AddLast(T data)
        {
            Node<T> newNode = new Node<T>(data);

            if (_head == null)
            {
                _head = newNode;
                _tail = newNode;
            }
            else
            {
                _tail!.Next = newNode;
                _tail = newNode;
            }
            _count++;
        }

        public bool Remove(T data)
        {
            if (_head == null) return false;
            if (Equals(_head.Data, data))
            {
                _head = _head.Next;
                if (_head == null) _tail = null;
                _count--;
                return true;
            }
            Node<T> current = _head;
            while (current.Next != null)
            {
                if (Equals(current.Next.Data, data))
                {
                    current.Next = current.Next.Next;
                    if (current.Next == null) _tail = current;
                    _count--;
                    return true;
                }
                current = current.Next;
            }
            return false;
        }

        public void Print()
        {
            Console.Write($"[Count={_count}]: ");
            Node<T>? current = _head;
            while (current != null)
            {
                Console.Write($"[{current.Data}] -> ");
                current = current.Next;
            }
            Console.WriteLine("null");
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Console.WriteLine("=== ВАРІАНТ 2: ОПТИМІЗАЦІЯ ВСТАВКИ В КІНЕЦЬ (_tail) ===\n");

            SinglyLinkedList<string> list = new SinglyLinkedList<string>();
            Stopwatch sw = Stopwatch.StartNew();

            Console.WriteLine("Додаємо елементи в кінець. Завдяки _tail це відбувається за O(1):");
            list.AddLast("Київ");
            list.AddLast("Житомир");
            list.AddLast("Львів");
            list.AddLast("Одеса");
            list.AddLast("Харків");
            
            list.Print();

            sw.Stop();
            Console.WriteLine($"\n⏱️ Час роботи: {sw.Elapsed.TotalMilliseconds:F4} ms");
            Console.WriteLine("(Якби _tail не було, додавання 100 000 елементів зайняло б секунди, а так - мілісекунди)");
        }
    }
}
